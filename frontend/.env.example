# =============================================================================
# REQUIRED
# =============================================================================

# FastAPI backend URL (no trailing slash)
# Local:      http://localhost:8000
# Production: https://your-backend.a.run.app
NEXT_PUBLIC_API_URL=http://localhost:8000

# Must match NEXTAUTH_SECRET in the FastAPI backend exactly.
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=

# Full URL of this Next.js app
NEXTAUTH_URL=http://localhost:3000

# MongoDB — used by Next.js API routes for user auth (NextAuth sessions + user model)
MONGODB_URI=

# Google OAuth — create credentials at console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# =============================================================================
# REQUIRED for real-time export progress
# =============================================================================
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=ap2

# =============================================================================
# REQUIRED for AI chat panel (/api/ai/chat) — server-side only, never NEXT_PUBLIC_
# =============================================================================
GEMINI_API_KEY=

# =============================================================================
# OPTIONAL — ImprovMX transactional email (welcome / Pro activation / password reset)
# Server-only — never expose IMPROVMX_API_KEY to the client bundle.
# =============================================================================
IMPROVMX_API_KEY="your_improvmx_api_key_here"
IMPROVMX_DOMAIN="quickaishort.online"
IMPROVMX_FROM_ALIAS="noreply"
# Unified verified human channel (Reply-To + UI mailto) — contact@ only
IMPROVMX_REPLY_TO="contact@quickaishort.online"
# Outbound fallback while ImprovMX free cannot send (daily_send=0)
RESEND_API_KEY="your_resend_api_key_here"
RESEND_FROM_EMAIL="noreply@quickaishort.online"
SUPPORT_EMAIL="contact@quickaishort.online"
FEEDBACK_EMAIL="contact@quickaishort.online"
GENERAL_EMAIL="contact@quickaishort.online"
ADMIN_SECRET=

# =============================================================================
# OPTIONAL — public contact mailbox (mailto links in UI). All aliases = contact@.
# =============================================================================
NEXT_PUBLIC_CONTACT_EMAIL="contact@quickaishort.online"
NEXT_PUBLIC_SUPPORT_EMAIL="contact@quickaishort.online"
NEXT_PUBLIC_FEEDBACK_EMAIL="contact@quickaishort.online"
NEXT_PUBLIC_GENERAL_EMAIL="contact@quickaishort.online"

# =============================================================================
# OPTIONAL — Sentry error monitoring (frontend). Leave unset to disable;
# Sentry.init() is a no-op without a DSN.
# =============================================================================
NEXT_PUBLIC_SENTRY_DSN=

# =============================================================================
# OPTIONAL — Studio Project Kernel (EP-002 / EP-006)
# Set to 1 on staging then production so chat commits + export bind to Kernel.
# =============================================================================
NEXT_PUBLIC_STUDIO_PROJECT_KERNEL=1

# =============================================================================
# OPTIONAL — Paddle Billing (Pro checkout overlay)
# =============================================================================
NEXT_PUBLIC_PADDLE_ENVIRONMENT="sandbox"
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN="your_paddle_client_token_here"
NEXT_PUBLIC_PADDLE_PRICE_ID_PRO="pri_your_pro_price_id_here"

# =============================================================================
# OPTIONAL — ADK Studio features (backend env vars — no frontend exposure needed)
# These are set in fastapi/.env, not here. Listed for documentation only.
# =============================================================================
# PEXELS_API_KEY        — stock video search in ADK Studio Step 2
# GOOGLE_TTS_API_KEY    — AI voiceover generation in ADK Studio Step 3
