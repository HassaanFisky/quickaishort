diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
new file mode 100644
index 0000000..5c2f269
--- /dev/null
+++ b/.github/workflows/ci.yml
@@ -0,0 +1,170 @@
+name: CI
+
+# Canonical CI pipeline for QuickAI Studio.
+#
+# Replaces the two previously overlapping workflows:
+#   - linter.yml                 (python-lint, frontend-lint)
+#   - deploy-video-pipeline.yml  (python-ci, frontend-ci)
+# Both ran black + flake8 + ESLint against the same commit, duplicating
+# ~4 minutes of runner time per push while neither executed the backend
+# pytest suite. Jobs below are split by concern so a red check names the
+# thing that is actually broken.
+
+on:
+  push:
+    branches: [main]
+  pull_request:
+    branches: [main]
+
+permissions:
+  contents: read
+
+concurrency:
+  group: ci-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  # ──────────────────────────────────────────────────────────────────────────
+  # Backend quality — formatting and fatal-error linting only.
+  # Deliberately does NOT install requirements.txt: these checks are static
+  # and must stay fast so formatting feedback is not gated on a ~2 min install.
+  # ──────────────────────────────────────────────────────────────────────────
+  backend-quality:
+    name: Backend quality (black + flake8 + syntax)
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+
+      - name: Set up Python 3.12
+        uses: actions/setup-python@v5
+        with:
+          python-version: "3.12"
+
+      - name: Install linters
+        run: pip install "black==26.5.1" flake8 --quiet
+
+      - name: Black format check
+        run: black --check fastapi/ --extend-exclude="venv/"
+
+      - name: Flake8 syntax & undefined names
+        run: |
+          flake8 fastapi/ \
+            --count \
+            --select=E9,F63,F7,F82 \
+            --show-source \
+            --statistics \
+            --exclude=venv
+
+      - name: Python syntax check (key agent files)
+        run: |
+          python -m py_compile fastapi/main.py
+          python -m py_compile fastapi/agent/viral_agent.py
+          python -m py_compile fastapi/agent/preflight_agent.py
+          python -m py_compile fastapi/agent/director_agent.py
+          echo "All Python files: OK"
+
+  # ──────────────────────────────────────────────────────────────────────────
+  # Backend tests — the gate that did not previously exist on pull requests.
+  #
+  # ffmpeg/ffprobe are installed on purpose. Two tests
+  # (test_cost_architecture.py, test_manifest_renderer.py) are guarded by
+  # `skipif(shutil.which("ffmpeg") is None)` and would otherwise silently
+  # skip, so CI would report green without ever executing the render-path
+  # assertions. Installing the binaries makes the green result truthful.
+  # ──────────────────────────────────────────────────────────────────────────
+  backend-tests:
+    name: Backend tests (pytest)
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+
+      - name: Set up Python 3.12
+        uses: actions/setup-python@v5
+        with:
+          python-version: "3.12"
+          cache: pip
+          cache-dependency-path: fastapi/requirements.txt
+
+      - name: Install ffmpeg (unskips render-path tests)
+        run: |
+          sudo apt-get update -qq
+          sudo apt-get install -y -qq ffmpeg
+          ffmpeg -version | head -1
+          ffprobe -version | head -1
+
+      - name: Install backend dependencies
+        run: |
+          python -m pip install --upgrade pip --quiet
+          pip install -r fastapi/requirements.txt --quiet
+          pip install pytest pytest-asyncio --quiet
+
+      # rootdir is fastapi/ because tests import first-party packages by
+      # bare name (`from models...`, `from services...`), not `fastapi.models`.
+      - name: Run pytest
+        working-directory: fastapi
+        run: python -m pytest tests/ -v --tb=short -rs
+
+  # ──────────────────────────────────────────────────────────────────────────
+  # Frontend quality — ESLint, tsc, production build.
+  # ──────────────────────────────────────────────────────────────────────────
+  frontend-quality:
+    name: Frontend quality (ESLint + tsc + build)
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+
+      - name: Install pnpm
+        uses: pnpm/action-setup@v4
+        with:
+          version: 10.28.2
+
+      - name: Set up Node.js 24
+        uses: actions/setup-node@v4
+        with:
+          node-version: "24"
+          cache: pnpm
+          cache-dependency-path: frontend/pnpm-lock.yaml
+
+      - name: Install dependencies
+        working-directory: frontend
+        run: pnpm install --frozen-lockfile
+
+      - name: ESLint
+        working-directory: frontend
+        run: pnpm lint
+
+      - name: TypeScript type check
+        working-directory: frontend
+        run: npx tsc --noEmit
+
+      - name: Next.js production build
+        working-directory: frontend
+        run: pnpm build
+        env:
+          # Dummy values so the build does not fail on missing env vars.
+          # These are non-secret placeholders, not real credentials.
+          NEXTAUTH_URL: "https://www.quickaishort.online"
+          NEXTAUTH_SECRET: "ci-dummy-secret"
+          NEXT_PUBLIC_API_URL: "https://quickai-api-y2cgnbsbxa-uc.a.run.app"
+          NEXT_PUBLIC_PUSHER_KEY: "dummy"
+          NEXT_PUBLIC_PUSHER_CLUSTER: "us2"
+
+  # ──────────────────────────────────────────────────────────────────────────
+  # Capability registry validation — EP-001 freeze.
+  # Own job: registry drift is an architectural violation, not a lint nit,
+  # and previously hid inside the Python lint job where a black failure
+  # would mask it.
+  # ──────────────────────────────────────────────────────────────────────────
+  capability-registry:
+    name: Capability registry validation (EP-001)
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+
+      - name: Set up Python 3.12
+        uses: actions/setup-python@v5
+        with:
+          python-version: "3.12"
+
+      - name: BE↔FE registry hash sync
+        run: python fastapi/scripts/check_registry_sync.py
